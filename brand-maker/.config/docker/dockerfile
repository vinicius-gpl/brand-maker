# Brand Maker: build estático com Node e entrega com Caddy (a imagem final não leva Node).
# Contexto do build: a pasta brand-maker/. Em produção quem constrói é o Komodo, no próprio hetzner
# (.komodo/komodo.toml); localmente:
#   docker compose -f brand-maker/.config/docker/compose.yml up --build
#   docker build -f brand-maker/.config/docker/dockerfile -t brand-maker brand-maker

# ---------- build ----------
FROM node:22-alpine AS build
WORKDIR /app

# Dependências primeiro: a camada fica em cache enquanto o lockfile não mudar.
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY . ./

# BASE_PATH vazio = site na raiz do domínio. SITE_URL entra no canonical, nas metatags,
# no sitemap.xml e no robots.txt; troque pelo endereço público ao publicar.
ARG BASE_PATH=""
ARG SITE_URL="http://localhost:8080"
ENV BASE_PATH=${BASE_PATH} SITE_URL=${SITE_URL}
RUN npm run build

# ---------- entrega ----------
FROM caddy:2-alpine
COPY .config/docker/caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/build /srv
# Porta 3000 dentro do container, como em todos os projetos.
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=3s CMD wget -qO- http://127.0.0.1:3000/ >/dev/null || exit 1
