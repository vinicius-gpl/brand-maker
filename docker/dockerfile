# Brand Maker: build estático com Node e entrega com Caddy (a imagem final não leva Node).
# Rode da raiz do repositório:  docker compose -f docker/compose.yaml up --build
# ou:                           docker build -f docker/dockerfile -t brand-maker .

# ---------- build ----------
FROM node:22-alpine AS build
WORKDIR /app

# Dependências primeiro: a camada fica em cache enquanto o lockfile não mudar.
COPY brand-maker/package.json brand-maker/package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY brand-maker/ ./

# BASE_PATH vazio = site na raiz do domínio. SITE_URL entra no canonical, nas metatags,
# no sitemap.xml e no robots.txt; troque pelo endereço público ao publicar.
ARG BASE_PATH=""
ARG SITE_URL="http://localhost:8080"
ENV BASE_PATH=${BASE_PATH} SITE_URL=${SITE_URL}
RUN npm run build

# ---------- entrega ----------
FROM caddy:2-alpine
COPY docker/caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/build /srv
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1
